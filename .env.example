##############################################
# Lumera Lead Capture — environment template
# Copy to .env and fill in. NEVER commit .env
##############################################

APP_ENV=production
APP_DEBUG=false
APP_URL=https://go.lumeradubai.com
APP_TIMEZONE=Asia/Dubai
# Generate with: php bin/console.php key:generate
APP_SECRET=
APP_SESSION_NAME=lumera_go_session
# Minutes of inactivity before an admin session expires
APP_SESSION_IDLE_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_AUTH=true

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Lumera Dubai Real Estate"
LEAD_RECIPIENT_EMAIL=
# lead_email | none
LEAD_REPLY_TO_MODE=lead_email

WHATSAPP_NUMBER=
WHATSAPP_DEFAULT_MESSAGE="Hello Lumera, I would like to know more about available properties."

RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

STORE_RAW_IP=false
# Absolute path preferred in production. Defaults to <project>/storage/logs
LOG_PATH=

# Maximum size for logo / favicon / background uploads, in megabytes.
# Clamped to 1–10 by the application.
UPLOAD_MAX_SIZE_MB=2

##############################################
# Analytics engine
##############################################

ANALYTICS_ENABLED=true

# Salt for the one-way visitor hash. Generate with:
#   php bin/console.php key:generate
# Rotating it retires every existing visitor identity, which is the intended
# way to reset attribution. Never expose it; it is server-only.
ANALYTICS_HASH_SALT=

# A visit ends after this much inactivity; the next event starts a new session.
ANALYTICS_SESSION_TIMEOUT_MINUTES=30

# How long the raw event timeline is kept. Daily rollups and sessions survive
# pruning, so historical reporting is unaffected.
ANALYTICS_RAW_RETENTION_DAYS=90

# Ingest rate limit per IP. Generous enough for a full funnel run.
ANALYTICS_RATE_LIMIT_MAX=300
ANALYTICS_RATE_LIMIT_WINDOW=600

# Used ONLY by `php bin/console.php admin:create` for the very first admin.
# Remove these values after the first admin has been created.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
